# =============================================================================
# MANGWALE SEARCH - ONE-CLICK DEPLOYMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and customize as needed
# Most defaults work out of the box for Docker deployment
# =============================================================================

# -----------------------------------------------------------------------------
# DEPLOYMENT CONFIG
# -----------------------------------------------------------------------------
DOMAIN=opensearch.mangwale.ai
HTTP_PORT=80
HTTPS_PORT=443
DASHBOARD_PORT=8081
NODE_ENV=production

# -----------------------------------------------------------------------------
# OPENSEARCH
# -----------------------------------------------------------------------------
OPENSEARCH_HOST=http://search-opensearch:9200
OPENSEARCH_URL=http://search-opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# MYSQL - Docker container
# -----------------------------------------------------------------------------
MYSQL_HOST=search-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=mangwale
MYSQL_USER=root
MYSQL_PASSWORD=changeme_strong_password
MYSQL_ROOT_PASSWORD=changeme_strong_password

# ✅ NEW: For sync script (via os.getenv)
MYSQL_PORT=3307
MYSQL_DATABASE=mangwale
MYSQL_USER=root
MYSQL_PASSWORD=secret

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://search-redis:6379/0
ENABLE_SEARCH_CACHE=true

# ✅ NEW: Embedding Service for NLU
EMBEDDING_SERVICE_URL=http://embedding-service:3101

# ✅ NEW: Intent Detection & NLU
ENABLE_INTENT_PARSING=true
ENABLE_STORE_MATCHING=true
ENABLE_DUAL_EMBEDDINGS=true
ENABLE_STRUCTURED_QUERIES=true

# ✅ NEW: LLM Integration
LLM_ENDPOINT=http://mangwale-ai:8000
LLM_INTENT_PARSING=true
LLM_MODEL=gpt-3.5-turbo

# ✅ NEW: Search Features
SEARCH_INTENT_DETECTION=true
SEARCH_STORE_MATCHING=true
SEARCH_DUAL_VECTORS=true
SEARCH_SEMANTIC_DEFAULT=false

# ✅ NEW: Logging & Monitoring
LOG_LEVEL=info
DEBUG=false

# ✅ NEW: Feature Flags
FEATURE_INTENT_ROUTING=true
FEATURE_STORE_CONTEXT=true
FEATURE_DUAL_EMBEDDINGS=true
FEATURE_LLM_STRUCTURED=true

# ✅ NEW: Cache TTL (seconds)
CACHE_TTL_INTENT=3600
CACHE_TTL_STORE=7200
CACHE_TTL_SEARCH=300

# ✅ NEW: Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ✅ NEW: CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ✅ NEW: Kafka
# ----------------------------------------------------------------------
# KAFKA / REDPANDA
# -----------------------------------------------------------------------------
KAFKA_BROKERS=search-redpanda:9092

# -----------------------------------------------------------------------------
# SEARCH API
# -----------------------------------------------------------------------------
PORT=3100

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_PERSONALIZATION=true
ENABLE_RERANKER=false

# -----------------------------------------------------------------------------
# CLICKHOUSE (Analytics)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=http://search-clickhouse:8123
CLICKHOUSE_URL=http://search-clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123

# -----------------------------------------------------------------------------
# EMBEDDING SERVICE
# -----------------------------------------------------------------------------
EMBEDDING_API_URL=http://search-embedding-service:3101
EMBEDDING_SERVICE_URL=http://search-embedding-service:3101

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
STORAGE_TYPE=minio

# MinIO (Primary Storage)
MINIO_URL=https://storage.mangwale.ai
MINIO_BUCKET=mangwale
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme_minio_secret

# S3 (Fallback/Backup)
S3_URL=https://mangwale.s3.ap-south-1.amazonaws.com
S3_BUCKET=mangwale
S3_REGION=ap-south-1

# Image paths
IMAGE_FALLBACK_ENABLED=true

