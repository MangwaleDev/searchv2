# ===========================================================================
# Exotel Voice API Routing - exotel.mangwale.ai
# ===========================================================================
# Routes Exotel callbacks and voice APIs to Mercury services
# Mercury IP: 192.168.0.151
# ===========================================================================

http:
  routers:
    # HTTP to HTTPS redirect
    exotel-redirect:
      rule: Host(`exotel.mangwale.ai`)
      entryPoints: [web]
      service: noop@internal
      middlewares: [exotel-redirect-https]

    # Nerve System API - primary callback (NO prefix stripping - Nerve expects /api/nerve/*)
    exotel-nerve:
      rule: Host(`exotel.mangwale.ai`) && PathPrefix(`/api/nerve`)
      entryPoints: [websecure]
      tls:
        certResolver: letsencrypt
      service: nerve-service
      priority: 100

    # Simple Exotel Caller Service (NEW) - Port 3151
    exotel-caller:
      rule: Host(`exotel.mangwale.ai`) && (PathPrefix(`/api/call`) || PathPrefix(`/exoml`) || PathPrefix(`/webhook`))
      entryPoints: [websecure]
      tls:
        certResolver: letsencrypt
      service: exotel-caller-service
      priority: 90

    # Exotel JS Service - other voice endpoints
    exotel-voice:
      rule: Host(`exotel.mangwale.ai`) && PathPrefix(`/api/voice`)
      entryPoints: [websecure]
      tls:
        certResolver: letsencrypt
      service: exotel-js-service
      priority: 85

    # Exotel JS Service - AI endpoints
    exotel-ai:
      rule: Host(`exotel.mangwale.ai`) && PathPrefix(`/api/ai`)
      entryPoints: [websecure]
      tls:
        certResolver: letsencrypt
      service: exotel-js-service
      priority: 80

    # UI Dashboard (catch-all)
    exotel-ui:
      rule: Host(`exotel.mangwale.ai`)
      entryPoints: [websecure]
      tls:
        certResolver: letsencrypt
      service: exotel-ui
      priority: 1

  middlewares:
    exotel-redirect-https:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    # Nerve System on Mercury - Port 7100
    nerve-service:
      loadBalancer:
        servers:
          - url: "http://192.168.0.151:7100"

    # Exotel JS Service on Mercury - Port 3100
    exotel-js-service:
      loadBalancer:
        servers:
          - url: "http://192.168.0.151:3100"

    # Exotel UI on Mercury - Port 3101
    exotel-ui:
      loadBalancer:
        servers:
          - url: "http://192.168.0.151:3101"

    # Simple Exotel Caller on Mercury - Port 3151
    exotel-caller-service:
      loadBalancer:
        servers:
          - url: "http://192.168.0.151:3151"
